<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameController.Companion.App.ViewModels"
             xmlns:c="using:GameController.Companion.App.Controls"
             x:Class="GameController.Companion.App.Views.LogView"
             x:DataType="vm:MainViewModel">
  <DockPanel Margin="32,26,32,32">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
      <StackPanel Spacing="2">
        <TextBlock Text="Log" Classes="h1" />
        <TextBlock Text="Connections, profile loads, warnings and errors since the companion started." Classes="muted wrap" />
      </StackPanel>
      <Button Grid.Column="1" VerticalAlignment="Center" Content="CLEAR" Command="{Binding ClearLogCommand}" />
    </Grid>
    <c:Plate Classes="panel" Padding="0">
      <ListBox Classes="plain" ItemsSource="{Binding Log}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LogRow">
            <Grid ColumnDefinitions="80,64,*" Margin="20,7">
              <TextBlock Text="{Binding Time}" Classes="num faint" FontSize="14" />
              <TextBlock Grid.Column="1" Text="{Binding LevelWord}" FontFamily="{StaticResource CondBold}" FontWeight="Bold"
                         FontSize="13" LetterSpacing="1" Foreground="{Binding LevelBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Message}" Classes="wrap" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </c:Plate>
  </DockPanel>
</UserControl>
