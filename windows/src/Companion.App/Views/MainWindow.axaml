<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameController.Companion.App.ViewModels"
        xmlns:c="using:GameController.Companion.App.Controls"
        xmlns:v="using:GameController.Companion.App.Views"
        x:Class="GameController.Companion.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="GameCtl Companion"
        Icon="avares://GameCtlCompanion/Assets/companion.ico"
        Width="1120" Height="760" MinWidth="820" MinHeight="560"
        Background="{StaticResource Ground}"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="236,*">

    <!-- Side rail -->
    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,20,14,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,0,26">
          <c:RigIcon Kind="wheel" Size="30" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="GAMECTL" FontFamily="{StaticResource CondXBold}" FontStyle="Italic" FontSize="19" />
            <TextBlock Text="Companion for Windows" Classes="small muted" />
          </StackPanel>
        </StackPanel>

        <!-- Closing the window only hides it; this is the way out. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Spacing="2">
          <Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="QUIT COMPANION" Command="{Binding QuitCommand}"
                  ToolTip.Tip="Stops the companion and releases every held input. Closing the window keeps it running in the tray." />
          <TextBlock Text="Closing the window keeps it in the tray" Classes="small faint" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- PC identity and link health -->
        <c:Plate DockPanel.Dock="Bottom" Shape="Cut" Fill="{StaticResource Ground}" Stroke="{StaticResource Line}" Padding="14,12">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding ServerName}" Classes="h3" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding HubDetail}" Classes="small muted num" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <Panel Width="10" Height="10" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="{StaticResource Green}" IsVisible="{Binding HasConnected}" />
                <Ellipse Width="9" Height="9" Stroke="{StaticResource InkFaint}" StrokeThickness="1.5"
                         IsVisible="{Binding !HasConnected}" />
              </Panel>
              <TextBlock Text="{Binding RailHealth}" Classes="small" Foreground="{StaticResource InkMuted}" />
            </StackPanel>
          </StackPanel>
        </c:Plate>

        <ListBox Classes="rail" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <Grid ColumnDefinitions="Auto,*,Auto" Height="44">
                <c:RigIcon Kind="{Binding Icon}" Size="20" VerticalAlignment="Center"
                           Foreground="{Binding $parent[ListBoxItem].Foreground}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource CondSemi}" FontSize="16" LetterSpacing="1.1"
                           Foreground="{Binding $parent[ListBoxItem].Foreground}" />
                <!-- State tag: a small slanted plate. Cap for counts, amber when something waits on the user. -->
                <c:Plate Grid.Column="2" Shape="Slant" IsVisible="{Binding Badge, Converter={x:Static c:Converters.NotEmpty}}"
                         MinWidth="26" Height="20" Padding="8,0" StrokeThickness="0"
                         VerticalAlignment="Center" Classes.attn="{Binding BadgeIsAttention}">
                  <c:Plate.Styles>
                    <Style Selector="c|Plate">
                      <Setter Property="Fill" Value="{StaticResource CapHigh}" />
                    </Style>
                    <Style Selector="c|Plate.attn">
                      <Setter Property="Fill" Value="{StaticResource Amber}" />
                    </Style>
                    <Style Selector="c|Plate TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource Ink}" />
                    </Style>
                    <Style Selector="c|Plate.attn TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource OnAmber}" />
                    </Style>
                  </c:Plate.Styles>
                  <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource CondXBold}" FontStyle="Italic" FontSize="14"
                             FontFeatures="+tnum" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </c:Plate>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Pages -->
    <Panel Grid.Column="1">
      <v:StatusView IsVisible="{Binding Page, Converter={x:Static c:Converters.Is}, ConverterParameter=status}" />
      <v:PhonesView IsVisible="{Binding Page, Converter={x:Static c:Converters.Is}, ConverterParameter=phones}" />
      <v:OutputsView IsVisible="{Binding Page, Converter={x:Static c:Converters.Is}, ConverterParameter=outputs}" />
      <v:LogView IsVisible="{Binding Page, Converter={x:Static c:Converters.Is}, ConverterParameter=log}" />
      <v:SettingsView IsVisible="{Binding Page, Converter={x:Static c:Converters.Is}, ConverterParameter=settings}" />
    </Panel>
  </Grid>
</Window>
